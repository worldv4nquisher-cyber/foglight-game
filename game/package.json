{
  "name": "game-studio-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "assets:test-lod": "node --import ./scripts/register-ts-paths.mjs scripts/gen-lod-test-asset.mjs",
    "test": "node --import ./scripts/register-ts-paths.mjs scripts/verify-lod.mjs && npm run test:assets && npm run test:input && npm run test:save && npm run test:physics && npm run test:camera && npm run test:quality && npm run test:text && npm run test:interaction && npm run test:narrative && npm run test:hint && npm run test:tide && npm run test:beam && npm run test:render && npm run test:flow && npm run test:s2 && npm run test:fonts",
    "test:assets": "node --import ./scripts/register-ts-paths.mjs scripts/verify-assets.mjs",
    "test:camera": "node --import ./scripts/register-ts-paths.mjs scripts/verify-camera.mjs",
    "test:physics": "node --import ./scripts/register-ts-paths.mjs scripts/verify-physics.mjs",
    "test:quality": "node --import ./scripts/register-ts-paths.mjs scripts/verify-quality.mjs",
    "test:save": "node --import ./scripts/register-ts-paths.mjs scripts/verify-save.mjs",
    "test:interaction": "node --import ./scripts/register-ts-paths.mjs scripts/verify-interaction.mjs",
    "test:narrative": "node --import ./scripts/register-ts-paths.mjs scripts/verify-narrative.mjs",
    "test:hint": "node --import ./scripts/register-ts-paths.mjs scripts/verify-hint.mjs",
    "test:tide": "node --import ./scripts/register-ts-paths.mjs scripts/verify-tide.mjs",
    "test:beam": "node --import ./scripts/register-ts-paths.mjs scripts/verify-beam.mjs",
    "test:text": "node --import ./scripts/register-ts-paths.mjs scripts/import-text.mjs --check",
    "text:import": "node --import ./scripts/register-ts-paths.mjs scripts/import-text.mjs",
    "test:input": "node --import ./scripts/register-ts-paths.mjs scripts/verify-input.mjs",
    "test:lod": "node --import ./scripts/register-ts-paths.mjs scripts/verify-lod.mjs",
    "verify:glb": "node --import ./scripts/register-ts-paths.mjs scripts/verify-lod.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run css",
    "smoke": "node --import ./scripts/register-ts-paths.mjs scripts/smoke-browser.mjs",
    "css": "node --import ./scripts/register-ts-paths.mjs scripts/check-css.mjs",
    "size": "node --import ./scripts/register-ts-paths.mjs scripts/check-size.mjs",
    "fonts": "node --import ./scripts/register-ts-paths.mjs scripts/subset-fonts.mjs",
    "test:fonts": "node --import ./scripts/register-ts-paths.mjs scripts/subset-fonts.mjs --check",
    "test:flow": "node --import ./scripts/register-ts-paths.mjs scripts/verify-flow.mjs",
    "test:s2": "node --import ./scripts/register-ts-paths.mjs scripts/verify-s2.mjs",
    "test:render": "node --import ./scripts/register-ts-paths.mjs scripts/verify-render.mjs"
  },
  "dependencies": {
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
